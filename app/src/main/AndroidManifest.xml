<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove"/>
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove"/>
    <uses-permission android:name="local.ttlab.permission.GALLERY"/>
    <uses-permission android:name="local.ttlab.permission.TELEGRAM"/>
    <uses-permission android:name="local.ttlab.permission.WEB"/>
    <uses-permission android:name="local.ttlab.permission.TELEGRAM_WEB"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS"/>
    <permission android:name="local.ttlab.permission.AUTHENTICATE" android:protectionLevel="signature"/>
    <queries>
        <package android:name="org.im.ttalk.lab"/>
        <package android:name="local.ttlab.web"/>
        <provider android:authorities="local.ttlab.web.bridge"/>
        <provider android:authorities="local.ttlab.bridge"/>
        <package android:name="${telegramPackage}"/>
        <provider android:authorities="${telegramAuthority}"/>
        <provider android:authorities="${telegramPackage}.web.bridge"/>
        <provider android:authorities="com.android.externalstorage.documents;com.android.providers.downloads.documents;com.android.providers.media.documents"/>
    </queries>
    <application android:name=".GalleryApplication" android:label="${galleryLabel}" android:theme="@style/GalleryTheme" android:allowBackup="false" android:fullBackupContent="false" android:usesCleartextTraffic="false" android:supportsRtl="true">
        <activity android:name=".ConnectorAuthActivity" android:exported="true" android:permission="local.ttlab.permission.AUTHENTICATE" android:excludeFromRecents="true"/>
        <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <activity android:name=".WebLibraryActivity" android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden"/>
        <activity android:name=".ViewerActivity" android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden"/>
        <activity android:name=".CombinedSearchActivity" android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden"/>
        <activity android:name=".LocalImportActivity" android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden"/>
        <activity android:name=".VisualActivity" android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden"/>
        <activity android:name=".StorageActivity" android:exported="false"/>
        <activity android:name=".DownloadsActivity" android:exported="false"/>
        <activity android:name=".StackActivity" android:exported="false"/>
        <activity android:name=".RecoveryActivity" android:exported="false"/>
        <service android:name=".DownloadService" android:exported="false" android:foregroundServiceType="dataSync"/>
        <service android:name=".SyncService" android:exported="false" android:foregroundServiceType="dataSync"/>
    </application>
</manifest>
