<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS"/>
    <permission android:name="local.ttlab.permission.SOURCE_SOCKETS" android:protectionLevel="signature"/>
    <queries><package android:name="${galleryPackage}"/></queries>
    <application android:allowBackup="false" android:usesCleartextTraffic="false"
        android:appComponentFactory="local.ttlab.isolated.IsolatedApplicationFactory">
        <service android:name="local.ttlab.isolated.SourceWorkerService" android:exported="true"
            android:externalService="true" android:isolatedProcess="true"/>
        <service android:name="local.ttlab.isolated.SocketBrokerService" android:exported="true"
            android:permission="local.ttlab.permission.SOURCE_SOCKETS" android:process=":sourceSockets"/>
    </application>
</manifest>
